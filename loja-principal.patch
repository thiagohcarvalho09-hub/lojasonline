Subject: [PATCH 1/6] =?UTF-8?q?D=C3=A1=20acesso=20de=20propriet=C3=A1ria?=
 =?UTF-8?q?=20a=20tefi7009@gmail.com=20no=20painel?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Migração 0004 promove a conta existente e garante o papel owner
em cadastros futuros com esse e-mail.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Jvo9yCU9cWoCRvyBWcjTuk
---
 supabase/migrations/0004_proprietaria.sql | 26 +++++++++++++++++++++++
 1 file changed, 26 insertions(+)
 create mode 100644 supabase/migrations/0004_proprietaria.sql

diff --git a/supabase/migrations/0004_proprietaria.sql b/supabase/migrations/0004_proprietaria.sql
new file mode 100644
index 0000000..8c1ae35
--- /dev/null
+++ b/supabase/migrations/0004_proprietaria.sql
@@ -0,0 +1,26 @@
+-- Garante que tefi7009@gmail.com seja proprietária da loja (acesso total ao /admin),
+-- tanto para a conta que já existe quanto para um cadastro futuro com esse e-mail.
+
+create or replace function public.handle_new_user() returns trigger
+language plpgsql security definer set search_path = public as $$
+begin
+  insert into public.profiles (id, full_name, email, role)
+  values (
+    new.id,
+    coalesce(new.raw_user_meta_data ->> 'full_name', split_part(new.email, '@', 1)),
+    new.email,
+    case
+      when lower(new.email) = 'tefi7009@gmail.com' then 'owner'
+      when exists (select 1 from public.profiles where role = 'owner') then 'customer'
+      else 'owner'
+    end
+  );
+  return new;
+end $$;
+
+-- Conta já cadastrada: cria o perfil se faltar e promove a proprietária.
+insert into public.profiles (id, full_name, email, role)
+select u.id, coalesce(u.raw_user_meta_data ->> 'full_name', split_part(u.email, '@', 1)), u.email, 'owner'
+from auth.users u
+where lower(u.email) = 'tefi7009@gmail.com'
+on conflict (id) do update set role = 'owner';
-- 
