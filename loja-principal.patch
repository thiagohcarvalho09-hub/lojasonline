+  staff boolean := public.is_staff();
+  v_channel text := 'online';
+  v_method text := coalesce(p ->> 'payment_method', 'pix');
+  v_email text := lower(trim(coalesce(p #>> '{customer,email}', '')));
+  v_name text := trim(coalesce(p #>> '{customer,name}', ''));
